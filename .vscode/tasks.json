{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "Run Bluebook document chat",
			"type": "shell",
			"command": "${workspaceFolder}/.venv/Scripts/python.exe",
			"args": [
				"-m",
				"uvicorn",
				"web_app:app",
				"--host",
				"127.0.0.1",
				"--port",
				"8000"
			],
			"isBackground": true,
			"problemMatcher": []
		},
		{
			"label": "Run SATHIS RAG document chat",
			"type": "shell",
			"command": "${workspaceFolder}/.venv/Scripts/python.exe",
			"args": [
				"-m",
				"uvicorn",
				"web_app:app",
				"--host",
				"127.0.0.1",
				"--port",
				"8000"
			],
			"isBackground": true,
			"problemMatcher": []
		},
		{
			"label": "Refresh Python dependency lock",
			"type": "shell",
			"command": "uv",
			"args": [
				"lock"
			],
			"isBackground": false,
			"problemMatcher": []
		},
		{
			"label": "Sync PostgreSQL app dependencies",
			"type": "shell",
			"command": "uv",
			"args": [
				"sync",
				"--group",
				"migration"
			],
			"isBackground": false,
			"problemMatcher": []
		}
	]
}